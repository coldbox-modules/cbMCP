 * www.ortussolutions.com
 * ---
 * MCP prompts for CacheBox health workflows.
 */
class extends="BasePrompt" {
	public void function register( required any mcpServer ) {
		arguments.mcpServer.registerPrompt(
			name        : "cache_health_report",
			description : "Produces a CacheBox health report for all cache providers",
			handler     : function( struct args = {} ) {
				return "Generate a CacheBox health report for this ColdBox application. Use the cachebox_get_all and cachebox_get_stats MCP tools to collect data on each cache provider, then summarise hit rates, eviction counts, object counts, and identify any providers showing signs of memory pressure or degraded performance."
			}
		)
	}
}