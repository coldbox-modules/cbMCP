 * ----------------------------------------------------------------------------------
 * Base class for all AI/MCP tool classes in the bx-ai module.
 *
 * Provides common utilities shared across tool implementations:
 * - Sensitive value masking for configuration and environment data
 * - Human-readable formatting (bytes, uptime)
 * - Dotted path resolution in nested structs
 * - JVM and OS system property helpers
 * - BoxLang runtime access
 */
import java:java.lang.System

class {
	/**
	 * Key patterns that indicate a struct key may contain sensitive data.
	 */
	static {
		runtime = getBoxRuntime()
		sensitivePatterns = [
			"password",
			"username",
			"secret",
			"key",
			"token",
			"credential",
			"auth",
			"connectionstring",
			"apikey",
			"api_key"
		]
	}

	/**
	 * Get the BoxLang runtime instance.
	 */
	public any function getRuntime() {
		return static.runtime
	}

	/**
	 * Recursively mask sensitive values in a struct. Keys matching sensitive patterns
	 * are replaced with "********". Nested structs are processed recursively.
	 *
	 * @data The struct to mask (modified in place)
	 */
	private struct function maskSensitiveValues( required struct data ) {
		var patterns = static.sensitivePatterns

		data.each(
				( k, v ) => {
					var keyLower = lCase( k )
					var isSensitive = false

					patterns.each(
							( pattern ) => {
								if ( keyLower.find( pattern ) ) {
									isSensitive = true
								}
							}
						)

					if ( isSensitive && isSimpleValue( v ) && len( v ) ) {
						data[ k ] = "********"
					} else if ( isStruct( v ) ) {
						maskSensitiveValues( v )
					}
				}
			)

		return data
	}

	/**
	 * Check if a key name matches any sensitive pattern.
	 *
	 * @keyName The key name to check
	 */
	private boolean function isSensitiveKey( required string keyName ) {
		var keyLower = lCase( arguments.keyName )

		return static.sensitivePatterns.some( ( pattern ) => keyLower.find( pattern ) )
	}

	// =========================================================================
	// Human-Readable Formatting
	// =========================================================================

	/**
	 * Format bytes into a human-readable string (B, KB, MB, GB).
	 *
	 * @bytes The number of bytes to format
	 */
	private string function formatBytes( required numeric bytes ) {
		if ( arguments.bytes < 0 ) {
			return "N/A"
		}
		if ( arguments.bytes < 1024 ) {
			return "#arguments.bytes# B"
		}
		if ( arguments.bytes < 1048576 ) {
			return "#numberFormat( arguments.bytes / 1024, "0.00" )# KB"
		}
		if ( arguments.bytes < 1073741824 ) {
			return "#numberFormat( arguments.bytes / 1048576, "0.00" )# MB"
		}
		return "#numberFormat( arguments.bytes / 1073741824, "0.00" )# GB"
	}

	/**
	 * Format milliseconds into a human-readable uptime string (e.g., "2d 5h 30m 15s").
	 *
	 * @millis The number of milliseconds to format
	 */
	private string function formatUptimeMillis( required numeric millis ) {
		if ( arguments.millis < 0 ) {
			return "unknown"
		}

		var totalSeconds = int( arguments.millis / 1000 )
		var days = int( totalSeconds / 86400 )
		var hours = int( ( totalSeconds % 86400 ) / 3600 )
		var minutes = int( ( totalSeconds % 3600 ) / 60 )
		var seconds = totalSeconds % 60

		return "#days#d #hours#h #minutes#m #seconds#s"
	}

	/**
	 * Format a date/time value into a human-readable uptime string.
	 *
	 * @startTime The start time (date object) to calculate uptime from
	 */
	private string function formatUptimeDate( required any startTime ) {
		if ( isNull( arguments.startTime ) ) {
			return "unknown"
		}

		var now = now()
		var diff = dateDiff(
			"s",
			arguments.startTime,
			now
		)
		var days = int( diff / 86400 )
		var hours = int( ( diff % 86400 ) / 3600 )
		var minutes = int( ( diff % 3600 ) / 60 )
		var seconds = diff % 60

		return "#days#d #hours#h #minutes#m #seconds#s"
	}

	// =========================================================================
	// Path Resolution
	// =========================================================================

	/**
	 * Resolve a dotted path in a nested struct (e.g., "datasources.mydb.host").
	 * Returns the value at the path, or an error struct if not found.
	 *
	 * @data The root struct to traverse
	 * @path The dotted path to resolve
	 */
	private any function resolvePath( required struct data, required string path ) {
		var parts = arguments.path.listToArray( "." )
		var current = arguments.data

		parts.each(
				( part ) => {
					if ( isStruct( current ) && current.keyExists( part ) ) {
						current = current[ part ]
					} else {
						return {
							"error"   : true,
							"message" : "Path not found: #arguments.path# (stopped at '#part#')"
						}
					}
				}
			)

		return current
	}

	// =========================================================================
	// System Property Helpers
	// =========================================================================

	/**
	 * Get JVM system property information.
	 */
	private struct function getJVMInfo() {
		return {
			"vendor"         : System.getProperty( "java.vendor" ) ?: "",
			"version"        : System.getProperty( "java.version" ) ?: "",
			"runtimeName"    : System.getProperty( "java.runtime.name" ) ?: "",
			"runtimeVersion" : System.getProperty( "java.runtime.version" ) ?: "",
			"home"           : System.getProperty( "java.home" ) ?: "",
			"vmName"         : System.getProperty( "java.vm.name" ) ?: "",
			"vmVersion"      : System.getProperty( "java.vm.version" ) ?: ""
		}
	}

	/**
	 * Get operating system information.
	 */
	private struct function getOSInfo() {
		return {
			"name"    : System.getProperty( "os.name" ) ?: "",
			"version" : System.getProperty( "os.version" ) ?: "",
			"arch"    : System.getProperty( "os.arch" ) ?: ""
		}
	}

	/**
	 * Get a single system property by name.
	 *
	 * @name The system property name
	 * @defaultValue The default value if the property is not set
	 */
	private string function getSystemProperty( required string name, string defaultValue = "" ) {
		return System.getProperty( arguments.name ) ?: arguments.defaultValue
	}

	/**
	 * Build out a BoxLang Key
	 */
	private Key function keyOf( required string name ) {
		return createObject( "java", "ortus.boxlang.runtime.scopes.Key" ).of( arguments.name )
	}

	// =========================================================================
	// Structured Health Report Builder
	// =========================================================================

	/**
	 * Creates a new health report internal builder struct.
	 * Used by _addIssue() and _buildHealthReport() to accumulate issues,
	 * penalties, and score breakdowns before final assembly.
	 */
	private struct function _newHealthReport() {
		return {
			"_issues"    : [],
			"_penalties" : 0,
			"_breakdown" : []
		}
	}

	/**
	 * Append an issue to the health report builder.
	 *
	 * @report           The health report builder struct from _newHealthReport()
	 * @severity         One of "critical", "warning", or "info"
	 * @code             Machine-readable issue code (e.g. "DS_POOL_SATURATED")
	 * @message          Human-readable description of the issue
	 * @suggestedAction  What the operator should do to resolve or investigate
	 * @entity           Optional name of the specific entity (datasource, cache, etc.)
	 * @entityMetrics    Optional struct of metrics relevant to this entity
	 */
	private void function _addIssue(
		required struct report,
		required string severity,
		required string code,
		required string message,
		required string suggestedAction,
		string entity,
		struct entityMetrics
	) {
		var issue = {
			"severity"        : arguments.severity,
			"code"            : arguments.code,
			"message"         : arguments.message,
			"suggestedAction" : arguments.suggestedAction
		}

		if ( !isNull( arguments.entity ) ) {
			issue[ "entity" ] = arguments.entity
		}
		if ( !isNull( arguments.entityMetrics ) ) {
			issue[ "entityMetrics" ] = arguments.entityMetrics
		}

		arguments.report._issues.append( issue )

		var penalty = 0
		switch ( lCase( arguments.severity ) ) {
			case "critical":
				penalty = 50
				break
			case "warning":
				penalty = 25
				break
			case "info":
				penalty = 5
				break
		}

		arguments.report._penalties += penalty
		arguments.report._breakdown.append( {
			"code"     : arguments.code,
			"severity" : arguments.severity,
			"penalty"  : penalty
		} )
	}

	/**
	 * Calculate a health score from 0-100 based on accumulated penalties.
	 *
	 * @report The health report builder struct from _newHealthReport()
	 *
	 * @return Numeric score between 0 and 100
	 */
	private numeric function _calculateHealthScore( required struct report ) {
		return max( 0, 100 - arguments.report._penalties )
	}

	/**
	 * Derive a traffic-light status string from a numeric health score.
	 *
	 * @score Numeric score between 0 and 100
	 *
	 * @return "healthy" (80-100), "warning" (50-79), or "critical" (0-49)
	 */
	private string function _deriveHealthStatus( required numeric score ) {
		if ( arguments.score >= 80 ) {
			return "healthy"
		}
		if ( arguments.score >= 50 ) {
			return "warning"
		}
		return "critical"
	}

	/**
	 * Build the final health report struct from the internal report builder.
	 *
	 * @report    The health report builder struct from _newHealthReport()
	 * @extraData Optional struct of additional keys to merge into the result
	 *
	 * @return Structured health report with status, score, issues, and scoreBreakdown
	 */
	private struct function _buildHealthReport(
		required struct report,
		struct extraData = {}
	) {
		var score  = _calculateHealthScore( arguments.report )
		var status = _deriveHealthStatus( score )

		var result = {
			"status"         : status,
			"score"          : score,
			"issues"         : arguments.report._issues,
			"scoreBreakdown" : {
				"base"       : 100,
				"deductions" : arguments.report._breakdown
			}
		}

		arguments.extraData.each( ( key, value ) => {
			if ( key != "_issues" && key != "_penalties" && key != "_breakdown" ) {
				result[ key ] = value
			}
		} )

		return result
	}
}