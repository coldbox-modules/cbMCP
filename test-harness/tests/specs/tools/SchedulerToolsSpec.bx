class extends="coldbox.system.testing.BaseTestCase" {

	/*********************************** LIFE CYCLE Methods ***********************************/

	function beforeAll() {
		super.beforeAll()
		setup()
	}

	function afterAll() {
		super.afterAll()
	}

	/*********************************** BDD SUITES ***********************************/

	function run() {
		describe( "SchedulerTools", function() {

			beforeEach( function( currentSpec ) {
				variables.tool = getInstance( "SchedulerTools@cbMCP" )
			} )

			it( "can get all schedulers as JSON", function() {
				var result = tool.scheduler_get_all()
				expect( result ).toBeArray()
			} )

			it( "returns scheduler entries with expected keys", function() {
				var result = tool.scheduler_get_all()
				// Not all apps have schedulers; if any exist, validate their shape
				if ( result.len() > 0 ) {
					var first = result[ 1 ]
					expect( first ).toHaveKey( "name" )
					expect( first ).toHaveKey( "executor" )
					expect( first ).toHaveKey( "timezone" )
					expect( first ).toHaveKey( "tasks" )
					expect( first ).toHaveKey( "taskCount" )
					expect( first.tasks ).toBeArray()
					expect( first.taskCount ).toBe( first.tasks.len() )
				}
			} )

			it( "tasks field is an array of string task names", function() {
				var result = tool.scheduler_get_all()
				result.each( ( scheduler ) => {
					expect( scheduler.tasks ).toBeArray()
					scheduler.tasks.each( ( taskName ) => {
						expect( taskName ).toBeString()
					} )
					expect( scheduler.taskCount ).toBe( scheduler.tasks.len() )
				} )
			} )

			// --- scheduler_get ---
			it( "returns an error string for a non-existent scheduler", function() {
				var result = tool.scheduler_get( "__nonExistentScheduler__" )
				expect( result ).toBeString()
				expect( result ).toInclude( "No scheduler found" )
			} )

			it( "can get details for an existing scheduler", function() {
				var schedulers = tool.scheduler_get_all()
				if ( schedulers.len() > 0 ) {
					var schedulerName = schedulers[ 1 ].name
					var result        = tool.scheduler_get( schedulerName )
					expect( result ).toBeStruct()
					expect( result ).toHaveKey( "name" )
					expect( result ).toHaveKey( "started" )
					expect( result ).toHaveKey( "taskCount" )
					expect( result ).toHaveKey( "tasks" )
					expect( result ).toHaveKey( "taskStats" )
				}
			} )

			// --- scheduler_get_task_stats ---
			it( "returns an error string for a non-existent task stats lookup", function() {
				var schedulers = tool.scheduler_get_all()
				if ( schedulers.len() > 0 ) {
					var result = tool.scheduler_get_task_stats( schedulers[ 1 ].name, "__nonExistentTask__" )
					expect( result ).toBeString()
					expect( result ).toInclude( "No task found" )
				}
			} )

			it( "can get stats for an existing task", function() {
				var schedulers = tool.scheduler_get_all()
				var found      = false
				schedulers.each( ( s ) => {
					if ( !found && s.tasks.len() > 0 ) {
						var result = tool.scheduler_get_task_stats( s.name, s.tasks[ 1 ] )
						expect( result ).toBeStruct()
						found = true
					}
				} )
			} )

			// --- scheduler_run_task ---
			it( "returns an error string when running a non-existent task", function() {
				var schedulers = tool.scheduler_get_all()
				if ( schedulers.len() > 0 ) {
					var result = tool.scheduler_run_task( schedulers[ 1 ].name, "__nonExistentTask__" )
					expect( result ).toBeString()
					expect( result ).toInclude( "No task found" )
				}
			} )

			// --- scheduler_pause_task ---
			it( "returns an error string when pausing with a non-existent scheduler", function() {
				var result = tool.scheduler_pause_task( "__nonExistentScheduler__", "anyTask" )
				expect( result ).toBeString()
				expect( result ).toInclude( "No scheduler found" )
			} )

			it( "returns an error string when pausing a non-existent task", function() {
				var schedulers = tool.scheduler_get_all()
				if ( schedulers.len() > 0 ) {
					var result = tool.scheduler_pause_task( schedulers[ 1 ].name, "__nonExistentTask__" )
					expect( result ).toBeString()
					expect( result ).toInclude( "No task found" )
				}
			} )

			it( "can pause an existing task", function() {
				var schedulers = tool.scheduler_get_all()
				var found      = false
				schedulers.each( ( s ) => {
					if ( !found && s.tasks.len() > 0 ) {
						var result = tool.scheduler_pause_task( s.name, s.tasks[ 1 ] )
						expect( result ).toBeString()
						expect( result ).toInclude( "paused" )
						// cleanup: resume so we don't leave the task disabled
						tool.scheduler_resume_task( s.name, s.tasks[ 1 ] )
						found = true
					}
				} )
			} )

			// --- scheduler_resume_task ---
			it( "returns an error string when resuming with a non-existent scheduler", function() {
				var result = tool.scheduler_resume_task( "__nonExistentScheduler__", "anyTask" )
				expect( result ).toBeString()
				expect( result ).toInclude( "No scheduler found" )
			} )

			it( "returns an error string when resuming a non-existent task", function() {
				var schedulers = tool.scheduler_get_all()
				if ( schedulers.len() > 0 ) {
					var result = tool.scheduler_resume_task( schedulers[ 1 ].name, "__nonExistentTask__" )
					expect( result ).toBeString()
					expect( result ).toInclude( "No task found" )
				}
			} )

			it( "can pause and then resume an existing task", function() {
				var schedulers = tool.scheduler_get_all()
				var found      = false
				schedulers.each( ( s ) => {
					if ( !found && s.tasks.len() > 0 ) {
						var taskName  = s.tasks[ 1 ]
						tool.scheduler_pause_task( s.name, taskName )
						var result = tool.scheduler_resume_task( s.name, taskName )
						expect( result ).toBeString()
						expect( result ).toInclude( "resumed" )
						found = true
					}
				} )
			} )

		} )
	}

}
